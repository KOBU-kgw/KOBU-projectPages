---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description = site.description, ogImage = '/og.png', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/apps/', label: 'Apps' },
  { href: '/#capabilities', label: 'Services' },
  { href: '/#about', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const sameAs = Object.values(site.social).filter(Boolean);
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  email: site.email,
  foundingDate: site.foundedAt,
  address: { '@type': 'PostalAddress', addressRegion: site.region, addressCountry: 'JP' },
  ...(sameAs.length ? { sameAs } : {}),
};

const stack = [
  'Swift / SwiftUI', 'Flutter', 'TypeScript', 'React', 'Astro',
  'Firebase', 'Cloud Functions', 'Cloudflare Workers', 'LINE', 'Git / GitHub',
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#06060b" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>

  <header class="site-nav" id="nav">
    <a href="/" class="nav-logo" aria-label={`${site.name} トップへ`}>
      <Logo size={28} />
      <span>KOBU</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="メニューを開く">
      <span></span><span></span>
    </button>
    <nav aria-label="メイン">
      <ul class="nav-links" id="nav-links">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) && item.href !== '/' ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-cta"><a href="/contact/?type=automation" class="btn btn-primary">無料で相談する</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="stack-strip" aria-label="主な使用技術">
        {stack.map((s) => <span>{s}</span>)}
      </div>
      <div class="footer-main">
        <div>
          <a href="/" class="nav-logo"><Logo size={22} /><span>KOBU</span></a>
          <p class="footer-note">{site.region}を拠点に、アプリ開発と業務自動化を行っています。</p>
        </div>
        <ul class="footer-links">
          <li><a href="/apps/">アプリ</a></li>
          <li><a href="/contact/">お問い合わせ</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
          {site.social.github && <li><a href={site.social.github} rel="noopener">GitHub</a></li>}
          {site.social.x && <li><a href={site.social.x} rel="noopener">X</a></li>}
          {site.social.line && <li><a href={site.social.line} rel="noopener">LINE</a></li>}
        </ul>
      </div>
      <p class="copyright">© 2026 {site.name}</p>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    });
    document.querySelectorAll('.nav-links a').forEach((a) =>
      a.addEventListener('click', () => {
        nav?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }),
    );

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('visible')),
      { threshold: 0.12 },
    );
    document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
  </script>
</body>
</html>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding: 16px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(6, 6, 11, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .site-nav:global(.scrolled) { border-bottom-color: var(--border); }

  .nav-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .nav-logo span {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 3px;
  }

  .nav-links { display: flex; align-items: center; gap: 28px; list-style: none; }
  .nav-links a:not(.btn) {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .nav-links a:not(.btn):hover,
  .nav-links a[aria-current='page'] { color: var(--blue-light); }
  .nav-cta .btn { padding: 9px 18px; font-size: 13px; }

  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    width: 40px;
    height: 40px;
    cursor: pointer;
    position: relative;
  }
  .nav-toggle span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 2px;
    background: var(--text-primary);
    transition: transform 0.2s;
  }
  .nav-toggle span:first-child { top: 15px; }
  .nav-toggle span:last-child { top: 23px; }
  .site-nav:global(.open) .nav-toggle span:first-child { transform: translateY(4px) rotate(45deg); }
  .site-nav:global(.open) .nav-toggle span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 760px) {
    .site-nav { padding: 12px 20px; flex-wrap: wrap; }
    .nav-toggle { display: block; }
    nav { width: 100%; }
    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px 0 8px;
    }
    .site-nav:global(.open) .nav-links { display: flex; }
    .nav-links a:not(.btn) { display: block; padding: 14px 0; font-size: 13px; }
    .nav-cta { margin-top: 8px; }
    .nav-cta .btn { width: 100%; padding: 14px; font-size: 15px; }
  }

  .site-footer { border-top: 1px solid var(--border); padding: 48px 0 32px; }
  .stack-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  .stack-strip span { font-family: var(--mono); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; }
  .footer-main { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .footer-note { font-size: 13px; color: var(--text-secondary); margin-top: 12px; }
  .footer-links { list-style: none; display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start; }
  .footer-links a { font-size: 13px; color: var(--text-secondary); text-decoration: none; }
  .footer-links a:hover { color: var(--blue-light); }
  .copyright {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 2px;
    margin-top: 40px;
  }
</style>
