---
import Base from '../../../layouts/Base.astro';
import StatusChip from '../../../components/StatusChip.astro';
import StoreLinks from '../../../components/StoreLinks.astro';
import { apps } from '../../../data/apps';

const app = apps.find((a) => a.slug === 'rakutan')!;

const features = [
  {
    num: '01',
    title: '空きコマから授業を探せる',
    text: '時間割の曜日・時限をタップすると、そのコマで受けられる授業が単位の取りやすさ順に並びます。',
  },
  {
    num: '02',
    title: '学期・学部・学年で絞り込み',
    text: '前期／後期／通年、全学共通や各学部の区分、対象学年で絞り込めます。シラバスは自動で集めています。',
  },
  {
    num: '03',
    title: '先輩のレビューが30秒で書ける',
    text: '受けた授業を★5段階で評価するだけ。名前は表示されません。気になる授業はLINEで友だちにシェアできます。',
  },
];
---
<Base
  title="楽単ナビ｜香川大学の空きコマから授業が探せる履修検索サイト"
  description="香大生が作った非公式の履修検索サイト。空きコマをタップすると、その時間の授業が単位の取りやすさ順に並びます。シラバスと学生の匿名レビューをまとめて検索できます。"
>
  <section class="page-head">
    <div class="container hero">
      <div>
        <div class="section-label"><a href="/apps/">// Apps</a> / 楽単ナビ</div>
        {app.icon && <img class="app-icon" src={app.icon} alt="" width="72" height="72" />}
        <p class="unofficial">（非公式）香川大学</p>
        <h1>楽単ナビ</h1>
        <p class="lead">香大生へ。<br />前期、何取った？</p>
        <p class="section-desc">
          シラバスと学生のレビューをまとめた、香川大学の履修検索サイトです。空きコマから、単位の取りやすい授業を探せます。
        </p>
        <div class="chips">{app.statuses.map((s) => <StatusChip status={s} />)}</div>
        <div class="store"><StoreLinks links={app.links} name={app.name} /></div>
        <p class="disclaimer">香大生が作った非公式サイトです。香川大学とは関係ありません。</p>
      </div>
      <div class="phone">
        <video
          src="/apps/rakutan/demo.mp4"
          poster="/apps/rakutan/demo-poster.webp"
          width="410"
          height="924"
          autoplay
          muted
          loop
          playsinline
          aria-label="空きコマ検索の操作画面。水曜の時限をタップすると、その時間の授業が単位の取りやすさ順に表示される"
        ></video>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">// Features</div>
      <h2 class="section-title">できること</h2>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <div class="card-icon">{f.num}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">// Screenshots</div>
      <h2 class="section-title">画面イメージ</h2>
      <div class="screens">
        <figure>
          <img src="/apps/rakutan/akikoma.webp" alt="空きコマ検索の画面。学期・学部区分・学年の絞り込みと、月〜土・1〜7限の時間割が並ぶ" width="897" height="2000" loading="lazy" />
          <figcaption>空きコマを選ぶ</figcaption>
        </figure>
        <figure>
          <img src="/apps/rakutan/list.webp" alt="選んだコマの授業一覧。科目ごとに単位の取りやすさの評価と件数が表示される" width="410" height="924" loading="lazy" />
          <figcaption>取りやすさ順に表示</figcaption>
        </figure>
      </div>
      <div class="promo">
        <video
          src="/apps/rakutan/promo.mp4"
          poster="/apps/rakutan/promo-poster.webp"
          width="1280"
          height="720"
          controls
          muted
          playsinline
          preload="none"
          aria-label="楽単ナビの紹介動画"
        ></video>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">// Next</div>
      <h2 class="section-title">履修が決まったら、課題はOIKOMIで</h2>
      <p class="section-desc">
        課題の「本当のヤバさ」を数値で知らせるタスク管理アプリ OIKOMI も、KOBU-Project がつくっています。
      </p>
      <div class="section-foot">
        <a class="btn btn-primary" href={app.links.web} rel="noopener">楽単ナビを開く <span class="arrow">→</span></a>
        <a class="btn btn-secondary" href="/apps/oikomi/">OIKOMIを見る <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 動きを減らす設定の人には、自動再生を止めて操作ボタンを出す
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
      v.autoplay = false;
      v.pause();
      v.controls = true;
    });
  }
</script>

<style>
  .section-label a { color: inherit; text-decoration: none; }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 56px;
    align-items: center;
  }
  .app-icon { width: 72px; height: 72px; border-radius: 18px; margin-bottom: 16px; }
  .unofficial { font-size: 13px; color: var(--text-secondary); letter-spacing: 1px; }
  h1 { font-size: clamp(36px, 6vw, 56px); font-weight: 700; line-height: 1.2; margin-bottom: 20px; }
  .lead { font-size: clamp(18px, 2.6vw, 24px); font-weight: 500; line-height: 1.6; margin-bottom: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .store { margin-top: 20px; }
  .disclaimer { font-size: 12px; color: var(--text-muted); margin-top: 16px; }

  .phone {
    width: 260px;
    padding: 10px;
    border-radius: 32px;
    background: #1b1b24;
    border: 1px solid var(--border);
  }
  .phone video { width: 100%; height: auto; border-radius: 22px; display: block; }

  .screens { display: flex; gap: 20px; margin-top: 40px; flex-wrap: wrap; }
  .screens figure { width: 220px; }
  .screens img { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--border); }
  .screens figcaption { font-size: 13px; color: var(--text-secondary); margin-top: 10px; text-align: center; }

  .promo { margin-top: 48px; max-width: 760px; }
  .promo video { width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border); display: block; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .phone { width: min(240px, 70%); margin: 0 auto; }
    .screens figure { width: calc(50% - 10px); }
  }
</style>
