---
import Base from '../../../layouts/Base.astro';
import StatusChip from '../../../components/StatusChip.astro';
import StoreLinks from '../../../components/StoreLinks.astro';
import { apps } from '../../../data/apps';

const app = apps.find((a) => a.slug === 'oikomi')!;
const screens = app.screenshots ?? [];

const features = [
  {
    num: '01',
    title: '「所要時間」と「やりたくなさ」を入れるだけ',
    text: '課題を追加するときは、所要時間とやりたくなさ（1〜10）をダイヤルで選ぶだけ。課題タイプはレポート・小テスト勉強・期末テストなどから選べます。',
  },
  {
    num: '02',
    title: '一覧は自動で「ヤバさ」順',
    text: '独自指標「TGL（Task Gotta Level）」が、所要時間・やりたくなさ・締切までの余裕から本当のヤバさを計算。まだ平和 → そのうちやろ → そろそろ現実 → 逃げ場なし → 戦争 の5段階で表示します。',
  },
  {
    num: '03',
    title: '必要なときだけ通知',
    text: '決まった時刻ではなく、課題の状態が変わったタイミングで通知。「気づいたら手遅れ」を防ぎます。タップで編集、左スワイプで完了、間違えても5秒以内なら取り消せます。',
  },
];

const points = ['完全無料', 'アカウント不要', 'オフラインで動作', 'データは端末内だけ'];

const faqs = [
  {
    q: '料金はかかりますか？',
    a: '無料で使えます。アカウントの登録も不要です。',
  },
  {
    q: 'Android版はありますか？',
    a: '現在テスト中で、近日公開予定です。公開時はこのページでお知らせします。',
  },
  {
    q: 'データはどこに保存されますか？',
    a: 'すべてお使いの端末の中に保存されます。サーバーへの送信やクラウド同期はなく、広告や利用状況の解析もありません。',
  },
  {
    q: '不具合を見つけた・要望がある場合は？',
    a: 'サポートページからご連絡ください。いただいた内容は今後の改善に活かします。',
  },
];
---
<Base
  title="OIKOMI｜課題の“本当のヤバさ”がわかるタスク管理アプリ"
  description="「あと3日あるし…」その油断が徹夜地獄に。OIKOMIは、所要時間とやりたくなさから課題の心理的なヤバさを計算し、5段階で知らせる大学生向けの課題管理アプリです。完全無料・アカウント不要。"
>
  <section class="page-head app-hero">
    <div class="container hero-inner">
      <div>
        <div class="section-label"><a href="/apps/">// Apps</a> / OIKOMI</div>
        <h1>OIKOMI</h1>
        <p class="lead">
          「あと3日あるし…」<br />その油断が、あなたを徹夜地獄へ。
        </p>
        <p class="section-desc">
          残り時間だけを見ていると「まだ1週間ある」と思ってしまう。でも、時間がかかって、しかもやりたくない課題なら、今動かないと本当にまずい。OIKOMIは課題を「心理的なヤバさ」で並べ替える、大学生のための課題管理アプリです。
        </p>
        <ul class="points">{points.map((p) => <li>{p}</li>)}</ul>
        <div class="chips">{app.statuses.map((s) => <StatusChip status={s} />)}</div>
        <div class="store">
          <StoreLinks links={app.links} name={app.name} />
        </div>
      </div>
      {app.icon
        ? <img class="big-icon" src={app.icon} alt="OIKOMIのアイコン" width="160" height="160" />
        : <div class="big-icon placeholder" aria-hidden="true">O</div>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">// Features</div>
      <h2 class="section-title">できること</h2>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <div class="card-icon">{f.num}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {screens.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-label">// Screenshots</div>
        <h2 class="section-title">画面イメージ</h2>
        <div class="screens">
          {screens.map((src, i) => (
            <img src={src} alt={`OIKOMIの画面 ${i + 1}`} loading="lazy" width="280" height="606" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-label">// FAQ</div>
      <h2 class="section-title">よくある質問</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label">// Support</div>
      <h2 class="section-title">サポート・お問い合わせ</h2>
      <p class="section-desc">使い方の質問、不具合の報告、ご要望はサポートページからどうぞ。</p>
      <div class="section-foot">
        <a class="btn btn-primary" href="/apps/oikomi/support/">サポートページ <span class="arrow">→</span></a>
        <a class="btn btn-secondary" href="/apps/oikomi/privacy/">プライバシーポリシー</a>
        <a class="btn btn-secondary" href="/apps/oikomi/terms/">利用規約</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-label a { color: inherit; text-decoration: none; }
  .section-label a:hover { text-decoration: underline; }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  h1 {
    font-family: var(--mono);
    font-size: clamp(40px, 7vw, 64px);
    letter-spacing: 6px;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .lead { font-size: clamp(18px, 2.6vw, 24px); font-weight: 500; line-height: 1.6; margin-bottom: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .points { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; font-size: 13px; }
  .points li::before { content: '✓ '; color: var(--blue-light); }
  .store { margin-top: 20px; }
  .big-icon { width: 160px; height: 160px; border-radius: 36px; }
  .big-icon.placeholder {
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 64px;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-deep), var(--blue-light));
  }
  .screens { display: flex; gap: 16px; overflow-x: auto; margin-top: 40px; padding-bottom: 8px; }
  .screens img { width: 240px; flex-shrink: 0; border-radius: 16px; border: 1px solid var(--border); height: auto; }

  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .big-icon { display: none; }
  }
</style>
