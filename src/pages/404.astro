---
import Base from '../layouts/Base.astro';
---
<Base title="ページが見つかりません" noindex>
  <section class="page-head">
    <div class="container">
      <div class="section-label">// 404</div>
      <h1 class="section-title">ページが見つかりません</h1>
      <p class="section-desc">URLが変わったか、ページが削除された可能性があります。</p>
      <div class="section-foot">
        <a class="btn btn-primary" href="/">トップへ戻る</a>
        <a class="btn btn-secondary" href="/apps/">アプリ一覧</a>
      </div>
    </div>
  </section>
</Base>
