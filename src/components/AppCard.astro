---
import type { App } from '../data/apps';
import StatusChip from './StatusChip.astro';
import StoreLinks from './StoreLinks.astro';

interface Props { app: App; showScreens?: boolean }
const { app, showScreens = true } = Astro.props;
const screens = showScreens ? (app.screenshots ?? []).slice(0, 3) : [];
---
<article class="app-card">
  <div class="app-head">
    {app.icon
      ? <img class="app-icon" src={app.icon} alt="" width="56" height="56" loading="lazy" />
      : <div class="app-icon placeholder" aria-hidden="true">{app.name.slice(0, 1)}</div>}
    <div>
      <h3>{app.detailPage ? <a href={app.detailPage}>{app.name}</a> : app.name}</h3>
      <p class="summary">{app.summary}</p>
    </div>
  </div>

  <div class="chips">
    {app.statuses.map((s) => <StatusChip status={s} />)}
  </div>

  <p class="desc">{app.description}</p>
  {app.note && <p class="note">{app.note}</p>}

  {screens.length > 0 && (
    <div class="screens">
      {screens.map((src, i) => (
        <img src={src} alt={`${app.name}の画面 ${i + 1}`} loading="lazy" width="200" height="433" />
      ))}
    </div>
  )}

  <div class="tags">{app.stack.map((t) => <span class="tag">{t}</span>)}</div>

  <div class="app-foot">
    <StoreLinks links={app.links} name={app.name} />
    {(app.detailPage || app.privacyPage) && (
      <div class="sub-links">
        {app.detailPage && <a href={app.detailPage}>詳しく見る →</a>}
        {app.privacyPage && <a href={app.privacyPage}>プライバシー</a>}
      </div>
    )}
  </div>
</article>

<style>
  .app-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
  }
  .app-card:hover { border-color: var(--border-hover); background: var(--bg-card-hover); transform: translateY(-3px); }

  .app-head { display: flex; gap: 16px; align-items: center; }
  .app-icon { width: 56px; height: 56px; border-radius: 14px; flex-shrink: 0; }
  .app-icon.placeholder {
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-deep), var(--blue-light));
  }
  h3 { font-size: 21px; font-weight: 700; line-height: 1.3; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--blue-light); }
  .summary { font-size: 13px; color: var(--text-secondary); margin-top: 4px; line-height: 1.6; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .desc { font-size: 14px; color: var(--text-secondary); line-height: 1.9; }
  .note { font-size: 13px; color: var(--blue-light); }

  .screens { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .screens img { border-radius: 10px; border: 1px solid var(--border); height: auto; }

  .app-foot { margin-top: auto; display: flex; flex-direction: column; gap: 14px; padding-top: 4px; }
  .sub-links { display: flex; gap: 20px; font-size: 13px; }
  .sub-links a { text-decoration: none; }
  .sub-links a:hover { text-decoration: underline; }
</style>
