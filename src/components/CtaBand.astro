---
interface Props {
  title?: string;
  text?: string;
  type?: string;
}
const {
  title = '「これ、自動化できる？」から気軽にどうぞ',
  text = 'まだ要件が固まっていなくても大丈夫です。今の困りごとを伺い、できること・できないことを正直にお伝えします。相談は無料です。',
  type = 'automation',
} = Astro.props;
---
<section class="cta-band">
  <div class="container inner fade-in">
    <h2>{title}</h2>
    <p>{text}</p>
    <a class="btn btn-primary" href={`/contact/?type=${type}`}>無料で相談する <span class="arrow">→</span></a>
  </div>
</section>

<style>
  .cta-band { padding: 96px 0; border-top: 1px solid var(--border); }
  .inner {
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(74, 108, 247, 0.12), transparent 70%);
    padding-top: 24px;
    padding-bottom: 24px;
  }
  h2 { font-size: clamp(22px, 3.5vw, 30px); font-weight: 700; line-height: 1.5; margin-bottom: 16px; }
  p { color: var(--text-secondary); font-size: 15px; max-width: 560px; margin: 0 auto 32px; }
</style>
